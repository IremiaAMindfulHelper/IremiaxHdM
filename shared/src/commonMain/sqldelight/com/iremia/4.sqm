-- Migration v4 -> v5: make the garden day- and month-aware.
-- Adds the entry's calendar day (year/month/dayOfMonth), a category
-- ('tree' for panic entries, 'flowerbed' for journal entries), so each month is
-- its own garden and the per-day-per-type rule can be enforced centrally.
ALTER TABLE gardenPlant ADD COLUMN category TEXT NOT NULL DEFAULT 'tree';
ALTER TABLE gardenPlant ADD COLUMN year INTEGER NOT NULL DEFAULT 0;
ALTER TABLE gardenPlant ADD COLUMN month INTEGER NOT NULL DEFAULT 0;
ALTER TABLE gardenPlant ADD COLUMN dayOfMonth INTEGER NOT NULL DEFAULT 0;

-- Backfill the calendar day for existing plants from their createdAt (millis).
-- SQLite's strftime works on seconds, hence the /1000. Also reposition each plant
-- onto its day-of-month tile (0-based) so old plants land on the new grid.
UPDATE gardenPlant SET
  year = CAST(strftime('%Y', createdAt / 1000, 'unixepoch', 'localtime') AS INTEGER),
  month = CAST(strftime('%m', createdAt / 1000, 'unixepoch', 'localtime') AS INTEGER),
  dayOfMonth = CAST(strftime('%d', createdAt / 1000, 'unixepoch', 'localtime') AS INTEGER),
  position = CAST(strftime('%d', createdAt / 1000, 'unixepoch', 'localtime') AS INTEGER) - 1;
