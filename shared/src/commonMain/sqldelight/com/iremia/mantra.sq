-- Table (if you haven’t already created it elsewhere)
CREATE TABLE mantra (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  text TEXT NOT NULL
);

-- Queries
selectAll:
SELECT id, text
FROM mantra
ORDER BY id DESC;

selectById:
SELECT id, text
FROM mantra
WHERE id = ?;

insertOne:
INSERT INTO mantra(text)
VALUES (?);

deleteById:
DELETE FROM mantra
WHERE id = ?;